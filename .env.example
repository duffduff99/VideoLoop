# ---- App ----
# Port on the host machine to reach the app at (http://<host>:HOST_PORT).
# Change this if 3000 is already in use.
HOST_PORT=3000

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Root path inside the container where the SMB share is mounted.
MEDIA_ROOT=/media

# Feed configuration (optional). When unset, every top-level folder under
# MEDIA_ROOT becomes a feed. Set FEEDS to choose exactly which folders are
# feeds and to point a feed at a specific subfolder, using a comma-separated
# list of "Display Name:relative/path" entries (path is relative to MEDIA_ROOT).
# Example: expose only two subfolders of the "main" share as feeds:
# FEEDS=Short Films:main/ShortFilms,Funny Clips:main/Funny

# Initial admin account, seeded on first boot if no users exist.
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Locked out? Set this to true and restart: the admin account above is reset to
# ADMIN_PASSWORD (other users and favorites are kept). Remove it afterwards.
# ADMIN_RESET_PASSWORD=true

# Session cookie "Secure" flag. Auto-detected by default (Secure only when the
# request came in over HTTPS, e.g. via a reverse proxy). Only set this if you
# need to force it one way or the other.
# COOKIE_SECURE=true

# SQLite database location (a persistent volume should be mounted here).
DATABASE_URL=file:/data/videoloop.db

# ---- Private feeds (optional) ----
# Feeds hidden everywhere until a user re-enters their own password in
# Settings -> Private feeds. Comma-separated display names.
# PRIVATE_FEEDS=Clips,Short Films
# Hours they stay visible after revealing (default 12).
# PRIVATE_UNLOCK_HOURS=12

# ---- SMB mounts (used by docker-compose volumes, not the app directly) ----
# Each share is mounted into its own subfolder of /media. You can mount a whole
# share, or a subpath of a share (e.g. SMB_SHARE=media/vacation) to make just
# that folder a feed.

# Share #1 -> /media/main
SMB_HOST=192.168.1.10
SMB_SHARE=media
SMB_USER=smbuser
SMB_PASSWORD=smbpassword

# Share #2 -> /media/secondary  (required while media_secondary is enabled in
# docker-compose.yml; comment that out if you only have one share)
SMB2_HOST=192.168.1.10
SMB2_SHARE=media
SMB2_USER=smbuser
SMB2_PASSWORD=smbpassword

# Share #3 (optional) -> /media/extra
# SMB3_HOST=192.168.1.20
# SMB3_SHARE=archive
# SMB3_USER=smbuser
# SMB3_PASSWORD=smbpassword
