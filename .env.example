# ---- App ----
# Secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Root path inside the container where the SMB share is mounted.
# Each top-level folder under here becomes a "feed".
MEDIA_ROOT=/media

# Initial admin account, seeded on first boot if no users exist.
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# SQLite database location (a persistent volume should be mounted here).
DATABASE_URL=file:/data/videoloop.db

# ---- Per-feed passwords (optional) ----
# Protect a feed by setting FEED_PASSWORD_<FEEDNAME>, where <FEEDNAME> is the
# folder name uppercased with non-alphanumeric characters replaced by "_".
# Example: a folder named "private-clips" -> FEED_PASSWORD_PRIVATE_CLIPS
# FEED_PASSWORD_PRIVATE_CLIPS=supersecret

# ---- SMB mount (used by docker-compose volume, not the app directly) ----
SMB_HOST=192.168.1.10
SMB_SHARE=media
SMB_USER=smbuser
SMB_PASSWORD=smbpassword
# SMB_DOMAIN=WORKGROUP
