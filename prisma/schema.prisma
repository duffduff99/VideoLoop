generator client {
  provider      = "prisma-client-js"
  // Include the Alpine (musl + openssl 3) engine so it works in the container.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  isAdmin   Boolean  @default(false)
  autoplay  Boolean  @default(true)
  createdAt DateTime @default(now())

  favorites Favorite[]
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  feed      String
  path      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feed, path])
  @@index([userId])
}

// A feed (playlist) shown on the home screen: a display name pointing at a
// folder below MEDIA_ROOT. Managed in the app under Settings -> Manage feeds.
model Feed {
  id        String   @id @default(cuid())
  name      String   @unique
  path      String // folder relative to MEDIA_ROOT, e.g. "main/Short Films"
  isPrivate Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Small key/value store for app-level flags.
model Setting {
  key   String @id
  value String
}
